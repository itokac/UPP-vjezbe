        <bpmn:incoming>Flow_1x8ggp0</bpmn:incoming>
        <bpmn:outgoing>Flow_0qxutv8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_1x8ggp0" sourceRef="Activity_0oaiwyw" targetRef="Activity_1w4nkbh" />
      <bpmn:task id="Activity_13plm4m" name="Evidentirati rezultate evaluacije">
        <bpmn:incoming>Flow_0qxutv8</bpmn:incoming>
        <bpmn:outgoing>Flow_08wv4gs</bpmn:outgoing>
      </bpmn:task>
