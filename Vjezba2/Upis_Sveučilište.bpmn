    <bpmn:task id="Dostavi" name="Dostaviti rang-liste sveučilištu" />
    <bpmn:task id="Provjeri" name="Provjeriti dostavljenu dokumentaciju" />
    <bpmn:exclusiveGateway id="Potpuna" name="Dokumentacija ispravna?" />
